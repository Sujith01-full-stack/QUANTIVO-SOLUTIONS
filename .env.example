# ===================================================================
# Quantivo Solutions — server-side configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets, and never prefix
# any secret with VITE_ (those are bundled into client JavaScript).
# ===================================================================

# --- Where resume applications are delivered -------------------------
# The company's verified HR / general contact address.
HR_EMAIL=techquantivosolutions@gmail.com

# Shown in the sender name of the application email.
COMPANY_NAME=Quantivo Solutions

# --- Email provider (any SMTP service: Gmail, Resend, SendGrid, etc.) --
# The API key / password below is the provider credential. It stays on
# the server and is never sent to the browser.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-api-key

# --- Server ----------------------------------------------------------
PORT=3001


# ===================================================================
# Optional client-side variable (public, non-secret).
# The WhatsApp number is public contact information, so it is safe in a
# VITE_ variable. Provide only the country code + number, digits only,
# with no "+", spaces or dashes — e.g. 919003912721 for +91 90039 12721.
#
# If omitted, the app falls back to the verified company number that is
# already configured in src/services/siteConfig.ts.
# ===================================================================
# VITE_COMPANY_WHATSAPP_NUMBER=919003912721
